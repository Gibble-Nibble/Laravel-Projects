APP_NAME="Laravel Projects"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_TSA3_CONNECTION=sqlite
DB_TSA3_DATABASE=database/tsa3.sqlite
DB_TFA8_CONNECTION=sqlite
DB_TFA8_DATABASE=database/tfa8.sqlite
DB_TSA4_CONNECTION=sqlite
DB_TSA4_DATABASE=database/tsa4.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
TSA4_TASK_COMPLETED_RECIPIENT="hello@example.com"
